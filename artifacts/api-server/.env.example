PORT=3000
FIREBASE_PROJECT_ID=your-firebase-project-id

# Set one Firebase Admin credential option:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# or configure GOOGLE_APPLICATION_CREDENTIALS for Application Default Credentials.

# Use a private random secret of at least 32 characters for HMAC-protected OTP storage.
EMAIL_OTP_SECRET=replace-with-a-private-random-secret-at-least-32-characters

# SMTP settings for delivery of real one-time verification codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=HelpChain <no-reply@example.com>

# Secret for a scheduled HTTP request to POST /api/donation-requests/expire.
# Schedule it at least every 5 minutes to expire reservations and send reminders.
DONATION_EXPIRY_SECRET=replace-with-a-private-random-secret-at-least-32-characters
