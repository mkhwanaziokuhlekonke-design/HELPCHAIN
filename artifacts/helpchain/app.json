{
  "expo": {
    "name": "HelpChain",
    "slug": "helpchain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "helpchain",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/helpchain-logo-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2747"
    },
    "ios": {
      "bundleIdentifier": "org.helpchain.app",
      "supportsTablet": false,
      "buildNumber": "1",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HelpChain uses your location to show nearby help requests and share your position during emergencies."
      }
    },
    "android": {
      "package": "org.helpchain.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-fg.png",
        "backgroundColor": "#0F2747"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HelpChain uses your location to show nearby help requests and share your position during emergencies."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
