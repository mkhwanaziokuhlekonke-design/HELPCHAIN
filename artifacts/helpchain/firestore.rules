rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only signed-in users can access any data
    function isAuthed() {
      return request.auth != null;
    }

    // User profiles — owner can write their own; anyone signed in can read
    match /users/{userId} {
      allow read: if isAuthed();
      allow write: if isAuthed() && request.auth.uid == userId;
    }

    // Help requests — any signed-in user can read/create;
    // only the requester or helper can update
    match /requests/{requestId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if isAuthed()
        && request.auth.uid == resource.data.requesterId;
    }

    // Community chat — any signed-in user can read and post
    match /chat/{messageId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // messages are immutable
    }

    // In-app notifications — any signed-in user can read;
    // app writes on behalf of users (server-side)
    match /notifications/{notifId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed(); // for marking read
      allow delete: if false;
    }

    // Donations — any signed-in user can read and create
    match /donations/{donationId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update, delete: if false;
    }
  }
}
