rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthed();
      allow write: if isAuthed() && request.auth.uid == userId;
    }

    // Help requests — all signed-in users can read & create; any signed-in user can update status
    match /requests/{requestId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if isAuthed() && request.auth.uid == resource.data.requesterId;
    }

    // Community chat — all signed-in users can read; sender must match auth uid
    match /chat/{messageId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // In-app notifications
    match /notifications/{notifId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAuthed();
      allow delete: if false;
    }

    // Donations
    match /donations/{donationId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update, delete: if false;
    }

    // Presence — each user writes their own doc; everyone signed-in can read all
    match /presence/{userId} {
      allow read: if isAuthed();
      allow write: if isAuthed() && request.auth.uid == userId;
    }
  }
}
